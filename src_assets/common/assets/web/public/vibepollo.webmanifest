{
  "id": "/v2/stream",
  "name": "Mirage Browser Stream",
  "short_name": "Mirage",
  "description": "Low-latency remote streaming from Mirage",
  "start_url": "/v2/stream",
  "scope": "/v2/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#101218",
  "theme_color": "#101218",
  "orientation": "any",
  "icons": [
    {
      "src": "/v2/images/apollo.ico",
      "sizes": "any",
      "type": "image/x-icon"
    }
  ]
}
